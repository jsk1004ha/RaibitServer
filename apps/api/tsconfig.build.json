{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": false,
    "incremental": false,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false
  },
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
