{
  "name": "raibitserver",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript-first monorepo plus Go infrastructure services for a container-first PaaS + DBaaS platform.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/webhook-worker"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "git diff --check && node scripts/check-structure.js",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && pnpm --filter @raibitserver/api typecheck && pnpm --filter @raibitserver/cli typecheck && pnpm --filter @raibitserver/dashboard typecheck",
    "test": "node --test",
    "check:structure": "node scripts/check-structure.js",
    "start:prototype-api": "node src/server.js",
    "cli": "node src/cli.js",
    "dev:up": "node scripts/dev-up.mjs",
    "dev:seed": "node scripts/dev-seed.mjs",
    "dev:e2e": "node scripts/dev-e2e.mjs --mode dry",
    "dev:down": "node scripts/dev-down.mjs",
    "e2e": "pnpm e2e:dry",
    "e2e:local": "pnpm e2e:dry",
    "prisma:validate": "node scripts/prisma-cli.mjs validate",
    "prisma:generate": "node scripts/prisma-cli.mjs generate",
    "e2e:dry": "node scripts/dev-e2e.mjs --mode dry",
    "e2e:live": "pnpm e2e:live:helm",
    "e2e:live:helm": "bash scripts/live-helm-e2e.sh",
    "dev:e2e:dry": "node scripts/dev-e2e.mjs --mode dry",
    "dev:e2e:live": "pnpm e2e:live:helm",
    "dev-up": "pnpm dev:up",
    "dev-e2e": "pnpm dev:e2e",
    "dev-down": "pnpm dev:down"
  },
  "bin": {
    "raibitserver-prototype": "src/cli.js"
  },
  "devDependencies": {
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "prisma": "6.19.0",
    "@prisma/client": "6.19.0",
    "yaml": "2.9.0",
    "@types/node": "25.9.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "keywords": [
    "paas",
    "dbaas",
    "kubernetes",
    "buildpacks",
    "dockerfile",
    "raibitserver",
    "monorepo",
    "go-controller"
  ],
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.1.2"
}
