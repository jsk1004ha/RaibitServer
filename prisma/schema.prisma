generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  studentId      String       @default("")
  clubMemberClaim Boolean      @default(false)
  avatarUrl      String?
  githubId       String?
  passwordHash   String?
  role           String       @default("USER")
  accountType    String       @default("NON_CLUB")
  approvalStatus String       @default("PENDING")
  sessionVersion Int          @default(0)
  bannedAt       DateTime?
  banExpiresAt   DateTime?
  banReason      String?
  bannedByUserId String?
  emailVerifiedAt DateTime?   @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships    Membership[]
  quotas         Quota[]
  usageRecords   UsageRecord[]
  auditLogs      AuditLog[]
  githubIntegrations GitHubIntegration[]
  emailVerificationCodes EmailVerificationCode[]
  sentOrganizationInvites OrganizationInvite[] @relation("OrganizationInviteInviter")

  @@index([bannedAt, banExpiresAt])
}

model EmailVerificationCode {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  purpose    String   @default("signup")
  payload    Json?
  codeHash   String
  codeSalt   String
  attempts   Int      @default(0)
  sentAt     DateTime @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, consumedAt, createdAt])
  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model OAuthTransaction {
  id            String   @id @default(uuid())
  stateHash     String   @unique
  sourceHash    String
  codeChallenge String
  redirectUri   String
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?
  failureCode   String?
  failedAt      DateTime?

  @@index([expiresAt])
}

model AuthRateLimit {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      String   @default("PERSONAL")
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Membership[]
  projects  Project[]
  githubIntegrations GitHubIntegration[]
  usageRecords UsageRecord[]
  invites OrganizationInvite[]
  domains   Domain[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  /// Canonical organization role; legacy aliases are read-only compatibility values.
  role           String       @default("DEVELOPER")
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model OrganizationInvite {
  id              String       @id @default(uuid())
  organizationId  String
  email           String
  role            String
  tokenHash       String       @unique
  tokenVersion    Int
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User         @relation("OrganizationInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, email, createdAt])
  @@index([expiresAt])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String       @default("")
  status         String       @default("ACTIVE")
  deletionRequestedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services       Service[]
  resources      Resource[]
  domains        Domain[]
  deployments    Deployment[]
  environmentVariables EnvironmentVariable[]
  usageRecords   UsageRecord[]
  environments Environment[]
  templateInstallations TemplateInstallation[]
  promotionPreviews PromotionPreview[]
  promotionOperations PromotionOperation[]
  notificationDestinations NotificationDestination[]
  notificationIntents NotificationIntent[]
  backupPolicies BackupPolicy[]
  backupPolicyRuns BackupPolicyRun[]
  objectUploadReservations ObjectUploadReservation[]
  objectStorageObjects ObjectStorageObject[]
  objectMultipartUploads ObjectMultipartUpload[]

  @@unique([organizationId, slug])
  @@index([status, updatedAt, createdAt])
  @@index([organizationId, createdAt, id])
  @@unique([id, organizationId])
}

model Service {
  id                 String       @id @default(cuid())
  projectId          String
  name               String
  slug               String
  type               String
  runtimeType        String       @default("container")
  sourceType         String
  buildMode          String       @default("AUTO")
  repoUrl            String?
  githubRepositoryId String?
  branch             String?
  rootDirectory      String?
  buildContext       String?
  dockerfilePath     String?
  installCommand     String?
  buildCommand       String?
  startCommand       String?
  outputDirectory    String?
  image              String?
  imageUrl           String?
  port               Int?
  healthCheckPath    String?
  livenessPath       String?
  readinessPath      String?
  publicHealthPath   String?
  desiredSpec        Json         @default("{}")
  desiredState       Json         @default("{}")
  status             String       @default("CREATED")
  deletionRequestedAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments        Deployment[]
  domains            Domain[]
  environmentVariables EnvironmentVariable[]
  runtimeLogs        RuntimeLog[]
  runtimeMetrics     RuntimeMetric[]
  attachments        ResourceAttachment[]
  usageRecords       UsageRecord[]
  environmentBinding EnvironmentService?

  @@unique([projectId, slug])
  @@index([status, updatedAt, createdAt])
  @@index([projectId, createdAt, id])
  @@unique([id, projectId])
}

model Deployment {
  id                String    @id @default(cuid())
  serviceId         String
  projectId         String
  environmentId     String?
  sourceDeploymentId String?
  retryOfDeploymentId String?
  requestIdempotencyKey String?
  desiredSpecSnapshot Json?
  requestedByUserId String?
  snapshotVersion Int?
  publicHealthStatus String? @default("UNKNOWN")
  healthCheckedAt DateTime?
  healthFailureCode String?
  observedGeneration Int?
  status            String    @default("QUEUED")
  deploymentType    String    @default("PRODUCTION")
  triggerType       String    @default("MANUAL")
  branch            String    @default("main")
  commitSha         String?
  commitHash        String?
  pullRequestNumber Int?
  previewUrl        String?
  previewLineageId   String?
  previewGeneration Int?
  previewRuntime    Json?
  previewOwnedObjects Json?
  imageUrl          String?
  imageDigest       String?
  buildStartedAt    DateTime?
  buildFinishedAt   DateTime?
  deployedAt        DateTime?
  finishedAt        DateTime?
  errorCode         String?
  errorMessage      String?
  reconcileAction   String?
  reconcileLockedBy String?
  reconcileLockedAt DateTime?
  reconcileAttempts Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  service           Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment       Environment? @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Restrict)
  buildLogs         BuildLog[]
  runtimeLogs       RuntimeLog[]
  runtimeMetrics    RuntimeMetric[]
  events            DeploymentEvent[]
  previewLineage PreviewLineage? @relation("PreviewAttempts", fields: [previewLineageId, projectId, serviceId], references: [id, projectId, serviceId], onDelete: Restrict)
  candidateFor PreviewLineage[] @relation("PreviewCandidate")
  currentFor PreviewLineage[] @relation("PreviewCurrent")

  @@index([serviceId, status])
  @@unique([serviceId, requestIdempotencyKey])
  @@index([sourceDeploymentId])
  @@index([projectId, deploymentType])
  @@index([status, reconcileLockedAt, createdAt])
  @@index([serviceId, createdAt, id])
  @@index([projectId, createdAt, id])
  @@index([environmentId, createdAt, id])
  @@unique([previewLineageId, previewGeneration])
  @@unique([id, previewLineageId, previewGeneration])
}

model PreviewLineage {
  id String @id
  organizationId String
  projectId String
  serviceId String
  environmentId String?
  integrationId String
  installationId String
  repositoryId String
  repository String
  pullRequestNumber Int
  stableHost String @unique
  namespace String
  routeName String
  state String
  version Int @default(1)
  generation Int @default(0)
  eventUpdatedAt DateTime
  eventAction String
  headSha String
  headRef String
  baseRef String
  beforeSha String?
  candidateDeploymentId String?
  candidateGeneration Int?
  currentDeploymentId String?
  currentGeneration Int?
  resolutionObservation Json?
  resolutionErrorCode String?
  routeIntent Json?
  routeObserved Json?
  reconcileToken String?
  reconcileWorker String?
  reconcileLeaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts Deployment[] @relation("PreviewAttempts")
  candidate Deployment? @relation("PreviewCandidate", fields: [candidateDeploymentId, id, candidateGeneration], references: [id, previewLineageId, previewGeneration], onDelete: Restrict)
  current Deployment? @relation("PreviewCurrent", fields: [currentDeploymentId, id, currentGeneration], references: [id, previewLineageId, previewGeneration], onDelete: Restrict)
  environment Environment? @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([organizationId, projectId, serviceId, installationId, repositoryId, pullRequestNumber], map: "PreviewLineage_identity")
  @@unique([id, projectId, serviceId])
  @@index([state, updatedAt])
  @@index([environmentId, updatedAt])
}

model BuildLog {
  id           String     @id @default(cuid())
  deploymentId String
  step         String
  line         String
  level        String     @default("info")
  timestamp    DateTime   @default(now())
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, timestamp])
  @@index([deploymentId, timestamp, id])
  @@index([deploymentId, step, timestamp, id])
}

model RuntimeLog {
  id            String      @id @default(cuid())
  serviceId     String
  deploymentId  String?
  podName       String
  podUid        String?
  containerName String
  line          String
  level         String      @default("info")
  sourceKey     String?     @unique
  timestamp     DateTime    @default(now())
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  deployment    Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  @@index([serviceId, timestamp])
  @@index([deploymentId, timestamp])
  @@index([serviceId, timestamp, id])
  @@index([deploymentId, timestamp, id])
  @@index([serviceId, deploymentId, podUid, containerName, timestamp, id])
	@@index([timestamp])
}

model RuntimeMetric {
  id            String      @id @default(cuid())
  serviceId     String
  deploymentId  String?
  podName       String
  podUid        String?
  containerName String
  metric        String
  value         Float
  unit          String
  sourceKey     String      @unique
  timestamp     DateTime    @default(now())
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  deployment    Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  @@index([serviceId, metric, timestamp])
  @@index([deploymentId, metric, timestamp])
  @@index([serviceId, timestamp, id])
  @@index([deploymentId, timestamp, id])
	@@index([timestamp])
}

model IngestionCursor {
  key       String   @id
  cursor    String
  updatedAt DateTime @updatedAt

	@@index([updatedAt])
}

model DeploymentEvent {
  id           String     @id @default(cuid())
  deploymentId String
  type         String
  message      String
  metadata     Json?
  timestamp    DateTime   @default(now())
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, timestamp])
  @@index([deploymentId, timestamp, id])
}

model Resource {
  id                   String   @id @default(cuid())
  projectId            String
  name                 String
  slug                 String
  type                 String
  engine               String
  provider             String
  plan                 String
  region               String
  version              String?
  status               String   @default("PROVISIONING")
  deletionRequestedAt  DateTime?
  desiredSpec          Json     @default("{}")
  desiredState         Json     @default("{}")
  connectionSecretName String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments          ResourceAttachment[]
  usageRecords         UsageRecord[]
  backups              ResourceBackup[]
  recoveryPins         ResourceRecoveryPin[]
  environmentBinding   EnvironmentResource?
  backupPolicy         BackupPolicy?
  backupPolicyRuns     BackupPolicyRun[]
  objectUploadReservations ObjectUploadReservation[]
  objectStorageObjects ObjectStorageObject[]
  objectMultipartUploads ObjectMultipartUpload[]

  @@unique([projectId, name])
  @@unique([projectId, slug])
  @@index([status, updatedAt, createdAt])
  @@index([projectId, createdAt, id])
  @@unique([id, projectId])
}

model ResourceAttachment {
  id          String   @id @default(cuid())
  resourceId  String
  serviceId   String
  envPrefix   String?
  injectedEnv Json
  createdAt   DateTime @default(now())
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, serviceId])
}

model ResourceBackup {
  id         String   @id @default(cuid())
  resourceId String
  status     String   @default("CREATED")
  path       String?
  metadata   Json?
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  formatVersion Int?
  organizationId String?
  projectId String?
  engine String?
  provider String?
  sourceGeneration String?
  sourceProvenance Json?
  sourceSpec Json?
  requestedByUserId String?
  requestIdempotencyKey String?
  requestFingerprint String?
  artifactKey String?
  artifactChecksum String?
  artifactSize BigInt?
  encryptionKeyVersion String?
  winningAttempt Int?
  cleanupToken String?
  cleanupWorker String?
  cleanupLeaseUntil DateTime?
  startedAt DateTime?
  deadlineAt DateTime?
  readyAt DateTime?
  expiresAt DateTime?
  updatedAt DateTime?
  errorCode String?
  origin String @default("manual")
  policyId String?
  policyRunId String? @unique
  policyVersion Int?
  scheduledAtUtc DateTime?
  policySnapshot Json?
  environmentId String?
  restores ResourceRestore[]
  recoveryPins ResourceRecoveryPin[]
  attempts ResourceRecoveryAttempt[]
  policyRun BackupPolicyRun? @relation("ResourceBackupPolicyRun", fields: [policyRunId], references: [id], onDelete: SetNull)
  reportedByPolicyRun BackupPolicyRun? @relation("BackupPolicyRunBackup")
  policy BackupPolicy? @relation(fields: [policyId], references: [id], onDelete: Restrict)
  environment Environment? @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([organizationId, resourceId, requestIdempotencyKey], map: "ResourceBackup_replay_key")
}

model ResourceRestore {
  id String @id
  formatVersion Int @default(1)
  organizationId String
  projectId String
  backupId String
  sourceResourceId String
  targetResourceId String @unique
  engine String
  provider String
  sourceGeneration String
  requestedByUserId String
  requestIdempotencyKey String
  requestFingerprint String
  status String @default("QUEUED")
  createdAt DateTime @default(now())
  updatedAt DateTime
  startedAt DateTime?
  deadlineAt DateTime?
  readyAt DateTime?
  errorCode String?
  targetCleanedAt DateTime?
  cleanupToken String?
  cleanupWorker String?
  cleanupLeaseUntil DateTime?
  backup ResourceBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)
  recoveryPins ResourceRecoveryPin[]

  @@unique([organizationId, backupId, requestIdempotencyKey])
}

model ResourceRecoveryPin {
  id String @id
  resourceId String
  backupId String
  restoreId String? @unique
  kind String
  createdAt DateTime @default(now())
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  backup ResourceBackup @relation(fields: [backupId], references: [id], onDelete: Restrict)
  restore ResourceRestore? @relation(fields: [restoreId], references: [id], onDelete: Restrict)

  @@index([resourceId], map: "ResourceRecoveryPin_resource")
}

model ResourceRecoveryAttempt {
  backupId String
  attempt Int
  objectKey String @unique
  uploadId String?
  keyVersion String
  firstClaimAt DateTime
  candidateStoredBytes BigInt?
  candidatePlaintextBytes BigInt?
  candidateChecksum String?
  state String
  cleanupPending Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  backup ResourceBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@id([backupId, attempt])
}

model Domain {
  id                               String       @id @default(cuid())
  organizationId                   String?
  projectId                        String?
  serviceId                        String?
  domain                           String       @unique
  type                             String       @default("CUSTOM")
  verified                         Boolean      @default(false)
  status                           String       @default("PENDING_VERIFICATION")
  verificationTokenHash            String?
  verificationVersion              Int          @default(1)
  issuedAt                          DateTime?
  expiresAt                         DateTime?
  verifiedAt                        DateTime?
  verificationRequestedAt          DateTime?
  lastCheckedAt                     DateTime?
  nextCheckAt                       DateTime?
  consecutiveFailures               Int          @default(0)
  tlsStatus                         String       @default("PENDING")
  desiredGeneration                 Int          @default(1)
  controllerLeaseGeneration         Int          @default(0)
  certificateObservedGeneration     Int          @default(0)
  routeObservedGeneration           Int          @default(0)
  cleanupRequiredForVersion         Int?
  certificateAbsentObservedVersion  Int?
  routeAbsentObservedVersion        Int?
  deletionRequestedAt               DateTime?
  actorUserId                       String?
  lastErrorCode                     String?
  lastErrorMessage                  String?
  createdAt                         DateTime     @default(now())
  updatedAt                         DateTime     @updatedAt
  organization                     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project                          Project?      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  service                          Service?      @relation(fields: [serviceId, projectId], references: [id, projectId], onDelete: Cascade)

  @@index([organizationId, projectId])
  @@index([serviceId, status])
  @@index([status, nextCheckAt])
}

model GitHubInstallation {
  id             String   @id @default(cuid())
  installationId String   @unique
  accountLogin   String
  accountType    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  generation     Int      @default(0)
  refreshStatus  String   @default("IDLE")
  lastSuccessfulSyncAt DateTime?
  staleAt        DateTime?
  repositories   GitHubRepository[]
}

model GitHubRepository {
  id             String   @id @default(cuid())
  installationId String
  githubRepoId   String   @unique
  owner          String
  name           String
  fullName       String
  defaultBranch  String   @default("main")
  private        Boolean  @default(false)
  normalizedIdentity String @default("")
  accessState    String   @default("ACCESSIBLE")
  generation     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  installation   GitHubInstallation @relation(fields: [installationId], references: [installationId], onDelete: Cascade)

  @@index([installationId, generation, normalizedIdentity, githubRepoId])
}

model GitHubSourceMutation {
  id             String   @id
  organizationId String
  operation      String
  idempotencyKey String
  requestHash    String
  response       Json
  createdAt      DateTime @default(now())

  @@unique([organizationId, operation, idempotencyKey])
  @@index([organizationId, createdAt])
}

model GitHubIntegration {
  id               String       @id @default(cuid())
  organizationId   String
  userId           String?
  accountLogin     String?
  installationId   String?
  tokenPreview     String?
  tokenFingerprint String?
  tokenSecretId    String?
  scopes           Json?
  defaultBranch    String       @default("main")
  status           String       @default("DISCONNECTED")
  version          Int          @default(1)
  verifiedAt       DateTime?
  disconnectedAt   DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([installationId])
}

model WebhookEvent {
  id           String   @id @default(cuid())
  provider     String
  eventType    String
  deliveryId   String   @unique
  payload      Json
  handled      Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())
}

model Quota {
  id                     String   @id @default(cuid())
  userId                 String
  accountType            String
  maxProjects            Int      @default(1)
  maxServices            Int      @default(2)
  maxDeploymentsPerDay   Int      @default(3)
  maxPreviewDeployments  Int      @default(1)
  maxCpuMillicores       Int      @default(500)
  maxMemoryMb            Int      @default(512)
  maxDbStorageMb         Int      @default(512)
  maxObjectStorageMb     Int      @default(1024)
  maxBuildMinutesPerMonth Int     @default(60)
  maxRuntimeHoursPerMonth Int     @default(120)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, accountType])
}

model UsageRecord {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  projectId      String?
  serviceId      String?
  resourceId     String?
  metric         String
  value          Float
  quantity       Float?
  unit           String
  labels         Json?
  recordedAt     DateTime @default(now())
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  resource       Resource?     @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([userId, metric, recordedAt])
  @@index([organizationId, metric, recordedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

model SecretValue {
  id          String   @id @default(cuid())
  scopeType   String
  scopeId     String
  key         String
  sealedValue String
  valueMasked String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scopeType, scopeId, key])
  @@index([scopeType, scopeId])
}

model EnvironmentVariable {
  id          String   @id @default(cuid())
  projectId   String
  serviceId   String
  key         String
  value       String?
  isSecret    Boolean  @default(false)
  valueMasked String
  secretRef   String?
  source      String   @default("api")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, key])
  @@index([projectId])
}

model WorkflowJob {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("queued")
  targetType  String
  targetId    String
  environmentId String?
  payload     Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  lockedBy    String?
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  operationalProtocolVersion Int @default(1)

  @@index([status, runAfter])
  @@index([targetType, targetId])
  @@index([environmentId, status, runAfter])
}

model Environment {
  id String @id
  projectId String
  kind String
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceBindings EnvironmentService[]
  resourceBindings EnvironmentResource[]
  deployments Deployment[]
  previewLineages PreviewLineage[]
  templateInstallations TemplateInstallation[]
  promotionSources PromotionPreview[] @relation("PromotionPreviewSource")
  promotionTargets PromotionPreview[] @relation("PromotionPreviewTarget")
